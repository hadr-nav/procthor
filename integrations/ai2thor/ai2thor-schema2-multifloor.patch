+                || !approximately(surface.transform.localPosition.x, 0.0f)
+                || !approximately(surface.transform.localPosition.y, 0.0f)
+                || !approximately(surface.transform.localPosition.z, 0.0f)
+                || Quaternion.Angle(surface.transform.localRotation, Quaternion.identity) > 0.1f
+                || !approximately(surface.transform.localScale.x, 1.0f)
+                || !approximately(surface.transform.localScale.y, 1.0f)
+                || !approximately(surface.transform.localScale.z, 1.0f)
+            ) {
+                return false;
+            }
+            var collider = surface.GetComponent<MeshCollider>();
+            if (
+                collider == null
+                || !collider.enabled
+                || collider.isTrigger
+                || collider.sharedMesh == null
+            ) {
+                return false;
+            }
+            var bounds = collider.sharedMesh.bounds;
+            return approximately(bounds.size.x, contract.flightWidth)
+                && approximately(bounds.size.y, contract.rise)
+                && approximately(bounds.size.z, contract.flightRun)
+                && approximately(bounds.center.x, 0.0f)
