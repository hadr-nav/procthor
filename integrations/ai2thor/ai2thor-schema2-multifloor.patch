+        private bool tryProjectMultiFloorMovementTarget(
+            Vector3 horizontalTarget,
+            float horizontalDistance,
+            float? targetY,
+            out Vector3 projectedTarget
+        ) {
+            projectedTarget = horizontalTarget;
+            NavMeshHit startHit;
+            var controllerScaleY = Mathf.Abs(
+                m_CharacterController.transform.lossyScale.y
+            );
+            var controllerBottomY = m_CharacterController.transform
+                .TransformPoint(m_CharacterController.center).y
+                - m_CharacterController.height * controllerScaleY / 2.0f;
+            if (!NavMesh.SamplePosition(
+                new Vector3(transform.position.x, controllerBottomY, transform.position.z),
+                out startHit,
+                0.35f,
+                NavMesh.AllAreas
+            )) {
+                errorMessage = "Agent is not on the schema-2 navmesh.";
+                return false;
+            }
+
+            var agentYOffset = transform.position.y - startHit.position.y;
+            var targetSurfaceY = targetY.HasValue
+                ? targetY.Value - agentYOffset
+                : startHit.position.y;
+            var query = horizontalTarget;
+            query.y = targetSurfaceY;
+            NavMeshHit targetHit;
+            var targetWasSampled = NavMesh.SamplePosition(
+                query,
+                out targetHit,
+                targetY.HasValue ? 0.35f : Mathf.Max(0.35f, horizontalDistance),
+                NavMesh.AllAreas
+            );
+            var targetXZ = new Vector2(horizontalTarget.x, horizontalTarget.z);
+            var hitXZ = targetWasSampled
+                ? new Vector2(targetHit.position.x, targetHit.position.z)
+                : Vector2.zero;
+            var usedLinkLookAhead = !targetWasSampled
+                || Vector2.Distance(targetXZ, hitXZ) > 0.3f;
+            if (usedLinkLookAhead) {
+                var movementXZ = new Vector2(
+                    horizontalTarget.x - transform.position.x,
+                    horizontalTarget.z - transform.position.z
+                ).normalized;
+                targetWasSampled = false;
+                foreach (var lookAheadDistance in new[] { 0.25f, 0.5f, 0.75f }) {
+                    var lookAheadQuery = new Vector3(
+                        horizontalTarget.x + movementXZ.x * lookAheadDistance,
+                        targetSurfaceY,
+                        horizontalTarget.z + movementXZ.y * lookAheadDistance
+                    );
+                    NavMeshHit lookAheadHit;
+                    if (!NavMesh.SamplePosition(
+                        lookAheadQuery,
+                        out lookAheadHit,
+                        0.25f,
+                        NavMesh.AllAreas
+                    )) {
+                        continue;
+                    }
+                    var lookAheadDelta = new Vector2(
+                        lookAheadHit.position.x - horizontalTarget.x,
+                        lookAheadHit.position.z - horizontalTarget.z
+                    );
+                    var alongMovement = Vector2.Dot(lookAheadDelta, movementXZ);
+                    var lateralOffset = (
+                        lookAheadDelta - movementXZ * alongMovement
+                    ).magnitude;
+                    if (
+                        alongMovement < -0.05f
+                        || alongMovement > lookAheadDistance + 0.25f
+                        || lateralOffset > 0.3f
+                    ) {
+                        continue;
+                    }
+                    targetHit = lookAheadHit;
+                    hitXZ = new Vector2(targetHit.position.x, targetHit.position.z);
+                    targetWasSampled = true;
+                    break;
+                }
+            }
+            if (!targetWasSampled) {
+                errorMessage = "No schema-2 navmesh surface at or ahead of the movement target.";
+                return false;
+            }
+            float currentPhysicalSurfaceY;
+            float targetPhysicalSurfaceY;
+            var hasCurrentPhysicalSurface = tryGetMultiFloorWalkableSurfaceY(
+                transform.position,
+                null,
+                out currentPhysicalSurfaceY
+            );
+            var hasTargetPhysicalSurface = tryGetMultiFloorWalkableSurfaceY(
+                horizontalTarget,
+                targetY,
+                out targetPhysicalSurfaceY
+            );
+            if (usedLinkLookAhead && !hasTargetPhysicalSurface) {
+                errorMessage =
+                    "Schema-2 link lookahead target has no supporting floor or connector surface.";
+                return false;
+            }
+            var hasPhysicalSurfaceHeights = hasCurrentPhysicalSurface
+                && hasTargetPhysicalSurface;
+            var surfaceHeightDelta = hasPhysicalSurfaceHeights
+                ? targetPhysicalSurfaceY - currentPhysicalSurfaceY
+                : targetHit.position.y - startHit.position.y;
+            if (
+                (!usedLinkLookAhead && Vector2.Distance(targetXZ, hitXZ) > 0.3f)
+                || Mathf.Abs(surfaceHeightDelta)
+                    > horizontalDistance * 0.8f + 0.05f
+            ) {
+                errorMessage = "Schema-2 movement target is not on a continuous local surface.";
+                return false;
+            }
+
+            var path = new NavMeshPath();
+            if (
+                !NavMesh.CalculatePath(
+                    startHit.position,
+                    targetHit.position,
+                    NavMesh.AllAreas,
+                    path
+                )
+                || path.status != NavMeshPathStatus.PathComplete
+            ) {
+                errorMessage = "Schema-2 movement target has no complete navmesh path.";
+                return false;
+            }
+            var pathLength = 0.0f;
+            for (int i = 1; i < path.corners.Length; i++) {
+                pathLength += Vector3.Distance(path.corners[i - 1], path.corners[i]);
+            }
+            if (pathLength > horizontalDistance * 5.0f + 0.1f) {
+                errorMessage = "Schema-2 movement target is not locally adjacent.";
+                return false;
+            }
+
+            projectedTarget = new Vector3(
+                horizontalTarget.x,
+                hasPhysicalSurfaceHeights
+                    ? transform.position.y + surfaceHeightDelta
+                    : targetHit.position.y
+                        + (transform.position.y - startHit.position.y),
+                horizontalTarget.z
+            );
+            return true;
+        }
