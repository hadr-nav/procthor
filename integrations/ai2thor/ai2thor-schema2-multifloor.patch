+        private bool tryGetMultiFloorWalkableSurfaceY(
+            Vector3 position,
+            float? raycastY,
+            out float surfaceY
+        ) {
+            var origin = new Vector3(
+                position.x,
+                raycastY.GetValueOrDefault(transform.position.y) + 0.5f,
+                position.z
+            );
+            var layerMask = ~LayerMask.GetMask("Agent", "SimObjInvisible");
+            foreach (
+                var hit in Physics
+                    .RaycastAll(origin, Vector3.down, 2.5f, layerMask)
+                    .OrderBy(candidate => candidate.distance)
+            ) {
+                var structure = hit.collider.GetComponentInParent<StructureObject>();
+                if (
+                    structure != null
+                    && structure.WhatIsMyStructureObjectTag == StructureObjectTag.Floor
+                ) {
+                    surfaceY = hit.point.y;
+                    return true;
+                }
+                var connector = hit.collider.GetComponentInParent<VerticalConnectorAsset>();
+                if (connector == null) {
+                    continue;
+                }
+                foreach (
+                    var connectorSurface in new[] {
+                        connector.walkableSurface,
+                        connector.lowerLandingSurface,
+                        connector.upperLandingSurface
+                    }
+                ) {
+                    if (
+                        connectorSurface != null
+                        && (
+                            hit.collider.gameObject == connectorSurface
+                            || hit.collider.transform.IsChildOf(
+                                connectorSurface.transform
+                            )
+                        )
+                    ) {
+                        surfaceY = hit.point.y;
+                        return true;
+                    }
+                }
+            }
+            surfaceY = 0.0f;
+            return false;
+        }
