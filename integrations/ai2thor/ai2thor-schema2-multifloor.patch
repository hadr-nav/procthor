+        private static void createMultiFloorRoomSurfaces(
+            ProceduralHouse house,
+            AssetMap<Material> materialDb,
+            GameObject floorRoot,
+            float receptacleHeight
+        ) {
+            foreach (var room in house.rooms) {
+                var roomObject = createSimObjPhysicsGameObject(room.id);
+                var roomVisibilityPoints = new GameObject("VisibilityPoints");
+                var roomColliders = new List<Collider>();
+                var roomReceptacles = new List<GameObject>();
+
+                for (int surfaceIndex = 0; surfaceIndex < room.floorPolygons.Count; surfaceIndex++) {
+                    var surface = room.floorPolygons[surfaceIndex];
+                    var surfaceObject = createSimObjPhysicsGameObject(
+                        surface.id,
+                        withRigidBody: false
+                    );
+                    var floorStructure = surfaceObject.AddComponent<StructureObject>();
+                    floorStructure.WhatIsMyStructureObjectTag = StructureObjectTag.Floor;
+                    var mesh = GenerateWorldSpaceFloorMesh(surface.polygon);
+                    surfaceObject.GetComponent<MeshFilter>().mesh = mesh;
+                    var materialProperties = surface.material ?? room.floorMaterial;
+                    var materialId = !String.IsNullOrEmpty(materialProperties.name)
+                        ? materialProperties.name
+                        : room.floorMaterial.name;
+                    surfaceObject.GetComponent<MeshRenderer>().material = generatePolygonMaterial(
+                        sharedMaterial: materialDb.getAsset(materialId),
+                        materialProperties: materialProperties,
+                        dimensions: getAxisAlignedWidthDepth(surface.polygon),
+                        squareTiling: house.proceduralParameters.squareTiling
+                    );
+
+                    var raycastCollider = surfaceObject.AddComponent<MeshCollider>();
+                    raycastCollider.sharedMesh = mesh;
+                    surfaceObject.layer = 12;
+
+                    var bounds = getRoomRectangle(surface.polygon);
+                    var dimension = bounds.max - bounds.min;
+                    var rectangle = new Rectangle() {
+                        center = bounds.min + dimension / 2.0f,
+                        width = dimension.x,
+                        depth = dimension.z
+                    };
+                    createFloorCollider(surfaceObject, rectangle, surface.slabThickness);
+                    var receptacle = createFloorReceptacle(
+                        surfaceObject,
+                        rectangle,
+                        receptacleHeight,
+                        namePostfix: $"_{surfaceIndex}"
+                    );
+                    roomReceptacles.Add(receptacle);
+                    roomColliders.AddRange(
+                        surfaceObject.GetComponentsInChildren<Collider>().Where(c => !c.isTrigger)
+                    );
+
+                    var interval = 1 / 3.0f;
+                    var visibilityPoints = Enumerable
+                        .Range(0, mesh.triangles.Length / 3)
+                        .Select(triangleIndex =>
+                            mesh.triangles.Skip(triangleIndex * 3)
+                                .Take(3)
+                                .Select(vertexIndex => mesh.vertices[vertexIndex])
+                        )
+                        .SelectMany(vertices =>
+                            GenerateTriangleVisibilityPoints(
+                                vertices.ElementAt(0),
+                                vertices.ElementAt(1),
+                                vertices.ElementAt(2),
+                                interval
+                            )
+                        );
+                    var surfaceVisibility = CreateVisibilityPointsGameObject(visibilityPoints);
+                    surfaceVisibility.transform.parent = roomVisibilityPoints.transform;
+                    surfaceObject.transform.parent = roomObject.transform;
+                }
+
+                if (!String.IsNullOrEmpty(room.layer)) {
+                    SetLayer<MeshRenderer>(roomObject, LayerMask.NameToLayer(room.layer));
+                }
+                roomObject.transform.parent = floorRoot.transform;
+                setRoomSimObjectPhysics(
+                    roomObject,
+                    room.id,
+                    roomVisibilityPoints,
+                    roomReceptacles.ToArray(),
+                    roomColliders.ToArray()
+                );
+                setRoomProperties(roomObject, room);
+            }
+        }
