+                surface == null
+                || anchor == null
+                || walkableSurface == null
+                || surface.transform != anchor
+                || surface.transform.parent != walkableSurface.transform
+                || Quaternion.Angle(surface.transform.localRotation, Quaternion.identity) > 0.1f
+                || !approximately(surface.transform.localScale.x, 1.0f)
+                || !approximately(surface.transform.localScale.y, 1.0f)
+                || !approximately(surface.transform.localScale.z, 1.0f)
+            ) {
+                return false;
+            }
+            var collider = surface.GetComponent<BoxCollider>();
+            if (
+                collider == null
+                || !collider.enabled
+                || collider.isTrigger
+                || surface.GetComponentsInChildren<Renderer>(true).Any(r => r.enabled)
+            ) {
+                return false;
+            }
+            var scale = surface.transform.lossyScale;
+            var width = Mathf.Abs(collider.size.x * scale.x);
+            var height = Mathf.Abs(collider.size.y * scale.y);
+            var depth = Mathf.Abs(collider.size.z * scale.z);
+            return approximately(width, expectedWidth)
+                && approximately(height, expectedHeight)
+                && approximately(depth, expectedDepth)
+                && approximately(collider.center.x, 0.0f)
+                && approximately(collider.center.z, 0.0f)
+                && approximately(
+                    collider.center.y + collider.size.y / 2.0f,
+                    0.0f
+                );
+        }
