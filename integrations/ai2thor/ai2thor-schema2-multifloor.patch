+                    var mesh = GenerateWorldSpaceFloorMesh(surface.polygon, clockWise: true);
+                    var ceilingObject = createSimObjPhysicsGameObject(
+                        surface.id,
+                        Vector3.zero,
+                        "Structure",
+                        0,
+                        withRigidBody: false
+                    );
+                    var structure = ceilingObject.AddComponent<StructureObject>();
+                    structure.WhatIsMyStructureObjectTag = StructureObjectTag.Ceiling;
+                    ceilingObject.GetComponent<MeshFilter>().mesh = mesh;
+                    var properties = surface.material ?? house.proceduralParameters.ceilingMaterial;
+                    var materialId = !String.IsNullOrEmpty(properties.name)
+                        ? properties.name
+                        : house.proceduralParameters.ceilingMaterial.name;
+                    ceilingObject.GetComponent<MeshRenderer>().material = generatePolygonMaterial(
+                        materialDb.getAsset(materialId),
+                        getAxisAlignedWidthDepth(surface.polygon),
+                        properties,
+                        squareTiling: house.proceduralParameters.squareTiling
+                    );
+                    ceilingObject.GetComponent<MeshRenderer>().shadowCastingMode =
+                        UnityEngine.Rendering.ShadowCastingMode.TwoSided;
+                    var collider = ceilingObject.AddComponent<MeshCollider>();
+                    collider.sharedMesh = mesh;
+                    tagObjectNavmesh(ceilingObject, "Not Walkable");
+                    ceilingObject.transform.parent = parent.transform;
+                }
+            }
+            return parent;
+        }
