+        private static bool pointInTriangle(
+            Vector2 point,
+            Vector2 a,
+            Vector2 b,
+            Vector2 c,
+            out Vector3 barycentric
+        ) {
+            var denominator = (b.y - c.y) * (a.x - c.x)
+                + (c.x - b.x) * (a.y - c.y);
+            if (Mathf.Abs(denominator) < 1e-6f) {
+                barycentric = Vector3.zero;
+                return false;
+            }
+            var u = ((b.y - c.y) * (point.x - c.x)
+                + (c.x - b.x) * (point.y - c.y)) / denominator;
+            var v = ((c.y - a.y) * (point.x - c.x)
+                + (a.x - c.x) * (point.y - c.y)) / denominator;
+            var w = 1.0f - u - v;
+            barycentric = new Vector3(u, v, w);
+            return u >= -1e-4f && v >= -1e-4f && w >= -1e-4f;
+        }
+
+        private Vector3[] getMultiFloorReachablePositions(
+            float gridMultiplier,
+            int maxStepCount,
+            bool directionsRelativeAgent,
+            float? requestedGridSize
+        ) {
+            var spacing = requestedGridSize.GetValueOrDefault(BaseFPSAgentController.gridSize)
+                * gridMultiplier;
+            if (spacing <= 0) {
+                throw new ArgumentException("gridSize must be positive.");
+            }
+            NavMeshHit startHit;
+            if (!NavMesh.SamplePosition(transform.position, out startHit, 2.0f, NavMesh.AllAreas)) {
+                throw new InvalidOperationException("Agent is not near the schema-2 NavMesh.");
+            }
+            var agentYOffset = transform.position.y - startHit.position.y;
+            var right = directionsRelativeAgent ? transform.right : Vector3.right;
+            var forward = directionsRelativeAgent ? transform.forward : Vector3.forward;
+            right.y = 0;
+            forward.y = 0;
+            right.Normalize();
+            forward.Normalize();
+
+            var triangulation = NavMesh.CalculateTriangulation();
+            var reachable = new HashSet<Vector3>();
+            var attempted = 0;
+            var candidateLimit = Math.Floor(maxStepCount / (spacing * spacing));
+            for (int triangle = 0; triangle < triangulation.indices.Length; triangle += 3) {
+                var worldA = triangulation.vertices[triangulation.indices[triangle]];
+                var worldB = triangulation.vertices[triangulation.indices[triangle + 1]];
+                var worldC = triangulation.vertices[triangulation.indices[triangle + 2]];
+                var a = new Vector2(
+                    Vector3.Dot(worldA - transform.position, right),
+                    Vector3.Dot(worldA - transform.position, forward)
+                );
+                var b = new Vector2(
+                    Vector3.Dot(worldB - transform.position, right),
+                    Vector3.Dot(worldB - transform.position, forward)
+                );
+                var c = new Vector2(
+                    Vector3.Dot(worldC - transform.position, right),
+                    Vector3.Dot(worldC - transform.position, forward)
+                );
+                var minU = Mathf.CeilToInt(Mathf.Min(a.x, Mathf.Min(b.x, c.x)) / spacing);
+                var maxU = Mathf.FloorToInt(Mathf.Max(a.x, Mathf.Max(b.x, c.x)) / spacing);
+                var minV = Mathf.CeilToInt(Mathf.Min(a.y, Mathf.Min(b.y, c.y)) / spacing);
+                var maxV = Mathf.FloorToInt(Mathf.Max(a.y, Mathf.Max(b.y, c.y)) / spacing);
+                for (int uIndex = minU; uIndex <= maxU; uIndex++) {
+                    for (int vIndex = minV; vIndex <= maxV; vIndex++) {
+                        attempted++;
+                        if (attempted > candidateLimit) {
+                            throw new InvalidOperationException(
+                                "Too many candidates in schema-2 GetReachablePositions."
+                            );
+                        }
+                        var uv = new Vector2(uIndex * spacing, vIndex * spacing);
+                        Vector3 weights;
+                        if (!pointInTriangle(uv, a, b, c, out weights)) {
+                            continue;
+                        }
+                        var surfaceY = weights.x * worldA.y
+                            + weights.y * worldB.y
+                            + weights.z * worldC.y;
+                        var query = transform.position
+                            + right * uv.x
+                            + forward * uv.y;
+                        query.y = surfaceY;
+                        NavMeshHit hit;
+                        if (!NavMesh.SamplePosition(
+                            query,
+                            out hit,
+                            Mathf.Max(0.1f, spacing * 0.45f),
+                            NavMesh.AllAreas
+                        )) {
+                            continue;
+                        }
+                        var path = new NavMeshPath();
+                        if (!NavMesh.CalculatePath(
+                            startHit.position,
+                            hit.position,
+                            NavMesh.AllAreas,
+                            path
+                        ) || path.status != NavMeshPathStatus.PathComplete) {
+                            continue;
+                        }
+                        reachable.Add(new Vector3(query.x, hit.position.y + agentYOffset, query.z));
+                    }
+                }
+            }
+            return reachable.ToArray();
+        }
