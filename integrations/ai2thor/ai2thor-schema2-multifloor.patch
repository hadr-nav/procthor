+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.AI;
+
+namespace Thor.Procedural {
+    /// <summary>
+    /// Contract implemented by curated structural connector prefabs.
+    /// The walkableSurface collider is an invisible continuous ramp used by
+    /// both the character controller and runtime navmesh baking.
+    /// </summary>
+    public class VerticalConnectorAsset : MonoBehaviour {
+        public string connectorType = "stairs";
+        public float referenceRise = 3.0f;
+        public float referenceRun = 4.5f;
+        public float referenceWidth = 1.0f;
+        public float reservedEnvelopeWidth = 1.2f;
+        public float reservedEnvelopeLength = 6.5f;
+        public GameObject walkableSurface;
+        public GameObject lowerLandingSurface;
+        public GameObject upperLandingSurface;
+        public Transform lowerLandingAnchor;
+        public Transform upperLandingAnchor;
+
+        private readonly List<NavMeshLinkInstance> runtimeNavMeshLinks =
+            new List<NavMeshLinkInstance>();
+
+        public void AddRuntimeNavMeshLink(NavMeshLinkData data) {
+            var instance = NavMesh.AddLink(data);
+            if (!instance.valid) {
+                throw new System.InvalidOperationException(
+                    $"Could not create a NavMesh link for connector '{gameObject.name}'."
+                );
+            }
+            instance.owner = this;
+            runtimeNavMeshLinks.Add(instance);
+        }
+
+        private void OnDestroy() {
+            foreach (var instance in runtimeNavMeshLinks) {
+                if (instance.valid) {
+                    instance.Remove();
+                }
+            }
+            runtimeNavMeshLinks.Clear();
+        }
+    }
+}
