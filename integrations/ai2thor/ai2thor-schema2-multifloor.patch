+                }
+
+                var lowerLandingCount = connector.landingPolygons.Count(landing =>
+                    landing.floorId == connector.lowerFloorId
+                    && landing.roomId == connector.lowerRoomId
+                );
+                var upperLandingCount = connector.landingPolygons.Count(landing =>
+                    landing.floorId == connector.upperFloorId
+                    && landing.roomId == connector.upperRoomId
+                );
+                var lowerOpeningCount = connector.openingPolygons.Count(opening =>
+                    opening.floorId == connector.lowerFloorId
+                    && opening.surfaceType == "ceiling"
+                );
+                var upperOpeningCount = connector.openingPolygons.Count(opening =>
+                    opening.floorId == connector.upperFloorId
+                    && opening.surfaceType == "floor"
+                );
+                if (
+                    lowerLandingCount != 1
+                    || upperLandingCount != 1
+                    || lowerOpeningCount != 1
+                    || upperOpeningCount != 1
+                ) {
+                    throw new ArgumentException(
+                        $"Connector {connector.id} must describe exactly its lower and upper landings/openings."
+                    );
+                }
+                var lowerOpening = connector.openingPolygons.Single(opening =>
+                    opening.floorId == connector.lowerFloorId
+                    && opening.surfaceType == "ceiling"
+                );
+                var upperOpening = connector.openingPolygons.Single(opening =>
+                    opening.floorId == connector.upperFloorId
+                    && opening.surfaceType == "floor"
+                );
+                var lowerLanding = connector.landingPolygons.Single(landing =>
+                    landing.floorId == connector.lowerFloorId
+                );
+                var upperLanding = connector.landingPolygons.Single(landing =>
+                    landing.floorId == connector.upperFloorId
+                );
+
+                var landingDepth = (contract.reservedLength - contract.flightRun) / 2.0f;
+                var landingCenterZ = (contract.reservedLength - landingDepth) / 2.0f;
+                var landingSizeX = Mathf.Abs(right.x) * contract.reservedWidth
+                    + Mathf.Abs(forward.x) * landingDepth;
+                var landingSizeZ = Mathf.Abs(right.z) * contract.reservedWidth
+                    + Mathf.Abs(forward.z) * landingDepth;
+                var openingSizeX = Mathf.Abs(right.x) * contract.reservedWidth
+                    + Mathf.Abs(forward.x) * contract.reservedLength;
+                var openingSizeZ = Mathf.Abs(right.z) * contract.reservedWidth
+                    + Mathf.Abs(forward.z) * contract.reservedLength;
+                foreach (var landing in connector.landingPolygons) {
+                    if (!floorsById.ContainsKey(landing.floorId)
+                        || !roomsById.ContainsKey(landing.roomId)
+                        || roomsById[landing.roomId].floorId != landing.floorId) {
+                        throw new ArgumentException($"Connector landing {landing.id} has invalid ownership.");
+                    }
+                    validateHorizontalRectangle(
+                        landing.polygon,
+                        floorsById[landing.floorId].baseY,
+                        $"connector landing {landing.id}"
+                    );
+                    var isLower = landing.floorId == connector.lowerFloorId;
+                    var localCenter = new Vector3(
+                        0.0f,
+                        isLower ? 0.0f : contract.rise,
+                        isLower ? -landingCenterZ : landingCenterZ
+                    );
+                    validateRectangleBounds(
+                        landing.polygon,
+                        connector.position + connectorRotation * localCenter,
+                        landingSizeX,
+                        landingSizeZ,
+                        $"connector landing {landing.id}"
+                    );
+                }
+                foreach (var opening in connector.openingPolygons) {
+                    if (!floorsById.ContainsKey(opening.floorId)
+                        || (opening.surfaceType != "floor" && opening.surfaceType != "ceiling")) {
+                        throw new ArgumentException($"Connector opening {opening.id} is invalid.");
+                    }
+                    var openingFloor = floorsById[opening.floorId];
+                    var openingY = opening.surfaceType == "floor"
+                        ? openingFloor.baseY
+                        : openingFloor.ceilingY;
+                    validateHorizontalRectangle(
+                        opening.polygon,
+                        openingY,
+                        $"connector opening {opening.id}"
+                    );
+                }
+                validateRectangleBounds(
+                    lowerOpening.polygon,
+                    new Vector3(
+                        connector.position.x,
+                        lowerFloor.ceilingY,
+                        connector.position.z
+                    ),
+                    openingSizeX,
+                    openingSizeZ,
+                    $"connector opening {lowerOpening.id}"
+                );
+                var upperFloorOpeningCenter = new Vector3(
+                    connector.position.x,
+                    upperFloor.baseY,
+                    connector.position.z
+                );
+                validateRectangleBounds(
+                    upperOpening.polygon,
+                    upperFloorOpeningCenter,
+                    openingSizeX,
+                    openingSizeZ,
+                    $"connector opening {upperOpening.id}"
+                );
+                var lowerFloorRooms = house.rooms.Where(room =>
+                    room.floorId == connector.lowerFloorId
+                );
+                var upperFloorRooms = house.rooms.Where(room =>
+                    room.floorId == connector.upperFloorId
+                );
+                var lowerFloorOpeningCenter = new Vector3(
+                    connector.position.x,
+                    lowerFloor.baseY,
+                    connector.position.z
+                );
+                var lowerFloorOpening = connectorRectangle(
+                    lowerFloorOpeningCenter,
+                    right,
+                    forward,
+                    contract.reservedWidth,
+                    contract.reservedLength
+                );
+                validateOpeningClear(
+                    lowerFloorOpening,
+                    lowerFloorRooms.SelectMany(room => room.floorPolygons)
+                        .Select(surface => surface.polygon),
+                    $"Connector {connector.id} lower-floor opening"
+                );
+                validateOpeningClear(
+                    lowerOpening.polygon,
+                    lowerFloorRooms.SelectMany(room => room.ceilings)
+                        .Select(surface => surface.polygon),
+                    $"Connector {connector.id} lower-ceiling opening"
+                );
+                validateOpeningClear(
+                    upperOpening.polygon,
+                    upperFloorRooms.SelectMany(room => room.floorPolygons)
+                        .Select(surface => surface.polygon),
+                    $"Connector {connector.id} upper-floor opening"
+                );
+                if (!assetDb.ContainsKey(connector.assetId)) {
+                    throw new ArgumentException($"Connector asset '{connector.assetId}' is not in the asset database.");
+                }
+                var prefab = assetDb.getAsset(connector.assetId);
+                var marker = prefab.GetComponent<VerticalConnectorAsset>();
+                if (marker == null || marker.connectorType != connector.connectorType
+                    || !approximately(prefab.transform.localScale.x, 1.0f)
+                    || !approximately(prefab.transform.localScale.y, 1.0f)
+                    || !approximately(prefab.transform.localScale.z, 1.0f)
+                    || !validRampSurface(marker.walkableSurface, contract)
+                    || marker.walkableSurface.transform.parent != prefab.transform
+                    || marker.lowerLandingAnchor == null
+                    || marker.upperLandingAnchor == null
+                    || !approximately(marker.lowerLandingAnchor.localPosition.x, 0.0f)
+                    || !approximately(marker.lowerLandingAnchor.localPosition.y, 0.0f)
+                    || !approximately(marker.lowerLandingAnchor.localPosition.z, -landingCenterZ)
+                    || !approximately(marker.upperLandingAnchor.localPosition.x, 0.0f)
+                    || !approximately(marker.upperLandingAnchor.localPosition.y, contract.rise)
+                    || !approximately(marker.upperLandingAnchor.localPosition.z, landingCenterZ)
+                    || !validLandingSurface(
+                        marker.lowerLandingSurface,
+                        marker.lowerLandingAnchor,
+                        marker.walkableSurface,
+                        contract.reservedWidth,
+                        landingDepth,
+                        lowerFloor.slabThickness
+                    )
+                    || !validLandingSurface(
+                        marker.upperLandingSurface,
+                        marker.upperLandingAnchor,
+                        marker.walkableSurface,
+                        contract.reservedWidth,
+                        landingDepth,
+                        upperFloor.slabThickness
+                    )
+                    || marker.walkableSurface
+                        .GetComponentsInChildren<Renderer>(true)
+                        .Any(r => r.enabled)
+                    || !approximately(marker.referenceRise, contract.rise)
+                    || !approximately(marker.referenceRun, contract.flightRun)
+                    || !approximately(marker.referenceWidth, contract.flightWidth)
+                    || !approximately(marker.reservedEnvelopeWidth, contract.reservedWidth)
+                    || !approximately(marker.reservedEnvelopeLength, contract.reservedLength)) {
+                    throw new ArgumentException($"Connector asset '{connector.assetId}' does not satisfy its contract.");
+                }
+            }
+            for (int index = 0; index < house.floors.Count - 1; index++) {
+                if (!connectorLowerFloorIndices.Contains(index)) {
+                    throw new ArgumentException(
+                        $"Schema 2 requires a connector from floor {index} "
+                        + $"to floor {index + 1}."
+                    );
+                }
+            }
+        }
+
+        private static Mesh createConnectedStairWalkableMesh(
+            ConnectorAssetContract contract
+        ) {
+            var halfFlightWidth = contract.flightWidth / 2.0f;
+            var halfLandingWidth = contract.reservedWidth / 2.0f;
+            var halfRun = contract.flightRun / 2.0f;
+            var halfEnvelope = contract.reservedLength / 2.0f;
+            var mesh = new Mesh() {
+                name = "ConnectedStairLandingRampCollider"
+            };
+            mesh.vertices = new Vector3[] {
+                new Vector3(-halfLandingWidth, 0.0f, -halfEnvelope),
+                new Vector3(halfLandingWidth, 0.0f, -halfEnvelope),
+                new Vector3(-halfFlightWidth, 0.0f, -halfRun),
+                new Vector3(halfFlightWidth, 0.0f, -halfRun),
+                new Vector3(-halfFlightWidth, contract.rise, halfRun),
+                new Vector3(halfFlightWidth, contract.rise, halfRun),
+                new Vector3(-halfLandingWidth, contract.rise, halfEnvelope),
+                new Vector3(halfLandingWidth, contract.rise, halfEnvelope)
+            };
+            mesh.triangles = new int[] {
+                0, 2, 1,
+                1, 2, 3,
+                2, 4, 3,
+                3, 4, 5,
+                4, 6, 5,
+                5, 6, 7
+            };
+            mesh.RecalculateNormals();
+            mesh.RecalculateBounds();
+            return mesh;
+        }
+
+        private static GameObject spawnVerticalConnectors(
+            IEnumerable<VerticalConnector> connectors,
+            GameObject structureRoot
+        ) {
+            var parent = new GameObject("VerticalConnectors");
+            parent.transform.parent = structureRoot.transform;
+            var assetDb = getAssetMap();
+            foreach (var connector in connectors) {
+                var instance = UnityEngine.Object.Instantiate(assetDb.getAsset(connector.assetId));
+                instance.name = connector.id;
+                instance.transform.position = connector.position;
+                instance.transform.rotation = connector.rotation.toQuaternion();
+                var structure = instance.GetComponent<StructureObject>();
+                if (structure == null) {
+                    structure = instance.AddComponent<StructureObject>();
+                }
+                structure.WhatIsMyStructureObjectTag = StructureObjectTag.Stairs;
+                var marker = instance.GetComponent<VerticalConnectorAsset>();
+                var walkableCollider = marker.walkableSurface.GetComponent<MeshCollider>();
+                walkableCollider.sharedMesh = null;
+                walkableCollider.sharedMesh = createConnectedStairWalkableMesh(
+                    connector.assetContract
+                );
+                var walkableStructure = marker.walkableSurface.GetComponent<StructureObject>();
+                if (walkableStructure == null) {
+                    walkableStructure = marker.walkableSurface.AddComponent<StructureObject>();
+                }
+                walkableStructure.WhatIsMyStructureObjectTag = StructureObjectTag.Stairs;
+                foreach (
+                    var landing in new[] {
+                        marker.lowerLandingSurface,
+                        marker.upperLandingSurface
+                    }
+                ) {
+                    var landingStructure = landing.GetComponent<StructureObject>();
+                    if (landingStructure == null) {
+                        landingStructure = landing.AddComponent<StructureObject>();
+                    }
+                    landingStructure.WhatIsMyStructureObjectTag = StructureObjectTag.Stairs;
+                }
+                SetLayer<Collider>(instance, LayerMask.NameToLayer("Procedural0"));
+                tagObjectNavmesh(marker.walkableSurface, "Walkable");
+                tagObjectNavmesh(marker.lowerLandingSurface, ignore: true);
+                tagObjectNavmesh(marker.upperLandingSurface, ignore: true);
+                instance.transform.parent = parent.transform;
+            }
+            return parent;
+        }
+
+        private static List<NavMeshHit> sampleRampAdjacentRoomNavMeshHits(
+            VerticalConnector connector,
+            bool upper,
+            Vector3 bridge,
+            Vector3 forward,
+            Vector3 right,
+            NavMeshQueryFilter queryFilter,
+            float agentRadius
+        ) {
+            var hits = new List<NavMeshHit>();
+            var floorDirection = upper ? 1.0f : -1.0f;
+            var floorY = connector.position.y
+                + (upper ? connector.assetContract.rise : 0.0f);
+            var edgeInset = agentRadius + 0.2f;
+            var halfLandingWidth = connector.assetContract.reservedWidth / 2.0f;
+            var halfEnvelopeLength = connector.assetContract.reservedLength / 2.0f;
+            const float sampleDistance = 0.2f;
+            foreach (
+                var roomQuery in new[] {
+                    bridge - right * (halfLandingWidth + edgeInset),
+                    bridge + right * (halfLandingWidth + edgeInset),
+                    connector.position
+                        + forward
+                            * floorDirection
+                            * (halfEnvelopeLength + edgeInset)
+                }
+            ) {
+                var query = roomQuery;
+                query.y = floorY;
+                NavMeshHit hit;
+                if (
+                    NavMesh.SamplePosition(
+                        query,
+                        out hit,
+                        sampleDistance,
+                        queryFilter
+                    )
+                ) {
+                    hits.Add(hit);
+                }
+            }
+            return hits;
+        }
+        private static bool wallBlocksConnectorLink(
+            Vector3 landingPosition,
+            Vector3 roomPosition
+        ) {
+            var start = landingPosition + Vector3.up * 0.5f;
+            var offset = roomPosition - landingPosition;
+            return Physics
+                .RaycastAll(
+                    start,
+                    offset.normalized,
+                    offset.magnitude
+                )
+                .Any(hit => {
+                    var structure = hit.collider.GetComponentInParent<StructureObject>();
+                    return structure != null
+                        && structure.WhatIsMyStructureObjectTag
+                            == StructureObjectTag.Wall;
+                });
+        }
+
+
+
+        private static List<(NavMeshHit landingHit, NavMeshHit roomHit)>
+            sampleLandingBoundaryNavMeshLinks(
+                VerticalConnector connector,
+                bool upper,
+                Vector3 forward,
+                Vector3 right,
+                NavMeshQueryFilter queryFilter,
+                float agentRadius
+            ) {
+            var links = new List<(NavMeshHit landingHit, NavMeshHit roomHit)>();
+            var floorDirection = upper ? 1.0f : -1.0f;
+            var landingY = connector.position.y
+                + (upper ? connector.assetContract.rise : 0.0f);
+            var landingDepth = (
+                connector.assetContract.reservedLength
+                - connector.assetContract.flightRun
+            ) / 2.0f;
+            var halfLandingWidth = connector.assetContract.reservedWidth / 2.0f;
+            var landingCenter = connector.position
+                + forward
+                    * floorDirection
+                    * (connector.assetContract.flightRun / 2.0f + landingDepth / 2.0f);
+            landingCenter.y = landingY;
+            var landingInset = agentRadius + 0.05f;
+            var roomInset = agentRadius + 0.2f;
+            const float sampleDistance = 0.2f;
+
+            foreach (var sideSign in new[] { -1.0f, 1.0f }) {
+                foreach (var longitudinalFraction in new[] { -0.25f, 0.0f, 0.25f }) {
+                    var edgeCenter = landingCenter
+                        + forward * landingDepth * longitudinalFraction;
+                    var landingQuery = edgeCenter
+                        + right * sideSign * (halfLandingWidth - landingInset);
+                    var roomQuery = edgeCenter
+                        + right * sideSign * (halfLandingWidth + roomInset);
+                    NavMeshHit landingHit;
+                    NavMeshHit roomHit;
+                    if (
+                        NavMesh.SamplePosition(
+                            landingQuery,
+                            out landingHit,
+                            sampleDistance,
+                            queryFilter
+                        )
+                        && NavMesh.SamplePosition(
+                            roomQuery,
+                            out roomHit,
+                            sampleDistance,
+                            queryFilter
+                        )
+                    ) {
+                        links.Add((landingHit, roomHit));
+                    }
+                }
+            }
+
+            foreach (var lateralFraction in new[] { -0.25f, 0.0f, 0.25f }) {
+                var edgeCenter = landingCenter
+                    + right * connector.assetContract.reservedWidth * lateralFraction;
+                var landingQuery = edgeCenter
+                    + forward
+                        * floorDirection
+                        * (landingDepth / 2.0f - landingInset);
+                var roomQuery = edgeCenter
+                    + forward
+                        * floorDirection
+                        * (landingDepth / 2.0f + roomInset);
+                NavMeshHit landingHit;
+                NavMeshHit roomHit;
+                if (
+                    NavMesh.SamplePosition(
+                        landingQuery,
+                        out landingHit,
+                        sampleDistance,
+                        queryFilter
+                    )
+                    && NavMesh.SamplePosition(
+                        roomQuery,
+                        out roomHit,
+                        sampleDistance,
+                        queryFilter
+                    )
+                ) {
+                    links.Add((landingHit, roomHit));
+                }
+            }
+            return links
+                .Where(link =>
+                    !wallBlocksConnectorLink(link.landingHit.position, link.roomHit.position)
+                )
+                .ToList();
+        }
+
+        private static void addVerticalConnectorNavMeshLinks(
+            IEnumerable<VerticalConnector> connectors
+        ) {
+            var navMeshSurfaces = GameObject.FindObjectsOfType<NavMeshSurfaceExtended>()
+                .Where(surface => surface.isActiveAndEnabled)
+                .ToArray();
+            var agentTypeIds = navMeshSurfaces
+                .Select(surface => surface.agentTypeID)
+                .Distinct()
+                .ToArray();
+            if (agentTypeIds.Length == 0) {
+                throw new InvalidOperationException(
+                    "Cannot connect vertical connectors because no active NavMesh surfaces exist."
+                );
+            }
+            foreach (var connector in connectors) {
+                var instance = GameObject.Find(connector.id);
+                var marker = instance.GetComponent<VerticalConnectorAsset>();
+                var forward = connector.rotation.toQuaternion() * Vector3.forward;
+                var right = connector.rotation.toQuaternion() * Vector3.right;
+                foreach (var agentTypeId in agentTypeIds) {
+                    var agentBuildSettings = navMeshSurfaces
+                        .First(surface => surface.agentTypeID == agentTypeId)
+                        .buildSettings;
+                    var queryFilter = new NavMeshQueryFilter() {
+                        agentTypeID = agentTypeId,
+                        areaMask = NavMesh.AllAreas
+                    };
+                    var rampInset = Mathf.Max(
+                        0.6f,
+                        agentBuildSettings.agentRadius + 0.4f
+                    );
+                    var lowerBridge = connector.position
+                        - forward
+                            * (connector.assetContract.flightRun / 2.0f - rampInset);
+                    var lowerStairQuery = lowerBridge;
+                    lowerStairQuery.y = connector.position.y
+                        + connector.assetContract.rise
+                            * rampInset
+                            / connector.assetContract.flightRun;
+
+                    var upperBridge = connector.position
+                        + forward
+                            * (connector.assetContract.flightRun / 2.0f - rampInset);
+                    var upperStairQuery = upperBridge;
+                    upperStairQuery.y = connector.position.y
+                        + connector.assetContract.rise
+                            * (1.0f
+                                - rampInset / connector.assetContract.flightRun);
+                    var seamInset = agentBuildSettings.agentRadius + 0.1f;
+                    var lowerMidQuery = connector.position - forward * seamInset;
+                    lowerMidQuery.y = connector.position.y
+                        + connector.assetContract.rise
+                            * (0.5f
+                                - seamInset / connector.assetContract.flightRun);
+                    var upperMidQuery = connector.position + forward * seamInset;
+                    upperMidQuery.y = connector.position.y
+                        + connector.assetContract.rise
+                            * (0.5f
+                                + seamInset / connector.assetContract.flightRun);
+
+                    NavMeshHit lowerStairHit;
+                    NavMeshHit lowerMidHit;
+                    NavMeshHit upperMidHit;
+                    NavMeshHit upperStairHit;
+                    const float sampleDistance = 0.2f;
+                    var lowerStairSampled = NavMesh.SamplePosition(
+                        lowerStairQuery,
+                        out lowerStairHit,
+                        sampleDistance,
+                        queryFilter
+                    );
+                    var lowerMidSampled = NavMesh.SamplePosition(
+                        lowerMidQuery,
+                        out lowerMidHit,
+                        sampleDistance,
+                        queryFilter
+                    );
+                    var upperMidSampled = NavMesh.SamplePosition(
+                        upperMidQuery,
+                        out upperMidHit,
+                        sampleDistance,
+                        queryFilter
+                    );
+                    var upperStairSampled = NavMesh.SamplePosition(
+                        upperStairQuery,
+                        out upperStairHit,
+                        sampleDistance,
+                        queryFilter
+                    );
+                    var lowerRampRoomHits = sampleRampAdjacentRoomNavMeshHits(
+                        connector,
+                        false,
+                        lowerBridge,
+                        forward,
+                        right,
+                        queryFilter,
+                        agentBuildSettings.agentRadius
+                    );
+                    var upperRampRoomHits = sampleRampAdjacentRoomNavMeshHits(
+                        connector,
+                        true,
+                        upperBridge,
+                        forward,
+                        right,
+                        queryFilter,
+                        agentBuildSettings.agentRadius
+                    );
+                    var lowerLandingLinks = sampleLandingBoundaryNavMeshLinks(
+                        connector,
+                        false,
+                        forward,
+                        right,
+                        queryFilter,
+                        agentBuildSettings.agentRadius
+                    );
+                    var upperLandingLinks = sampleLandingBoundaryNavMeshLinks(
+                        connector,
+                        true,
+                        forward,
+                        right,
+                        queryFilter,
+                        agentBuildSettings.agentRadius
+                    );
+                    if (
+                        !lowerStairSampled
+                        || !lowerMidSampled
+                        || !upperMidSampled
+                        || !upperStairSampled
+                    ) {
+                        throw new InvalidOperationException(
+                            $"Connector '{connector.id}' has no NavMesh on its ramp "
+                            + $"for agent type {agentTypeId} "
+                            + $"(lower: {lowerStairSampled}, "
+                            + $"lower mid: {lowerMidSampled}, "
+                            + $"upper mid: {upperMidSampled}, "
+                            + $"upper: {upperStairSampled})."
+                        );
+                    }
+                    lowerRampRoomHits = lowerRampRoomHits
+                        .Where(hit =>
+                            !wallBlocksConnectorLink(lowerStairHit.position, hit.position)
+                        )
+                        .ToList();
+                    upperRampRoomHits = upperRampRoomHits
+                        .Where(hit =>
+                            !wallBlocksConnectorLink(upperStairHit.position, hit.position)
+                        )
+                        .ToList();
+                    if (
+                        lowerRampRoomHits.Count == 0
+                        || upperRampRoomHits.Count == 0
+                    ) {
+                        throw new InvalidOperationException(
+                            $"Connector '{connector.id}' has no adjacent room NavMesh "
+                            + $"for agent type {agentTypeId} "
+                            + $"(lower ramp: {lowerRampRoomHits.Count}, "
+                            + $"upper ramp: {upperRampRoomHits.Count}, "
+                            + $"lower landing: {lowerLandingLinks.Count}, "
+                            + $"upper landing: {upperLandingLinks.Count})."
+                        );
+                    }
+
+                    foreach (var roomHit in lowerRampRoomHits) {
+                        marker.AddRuntimeNavMeshLink(
+                            new NavMeshLinkData() {
+                                startPosition = roomHit.position,
+                                endPosition = lowerStairHit.position,
+                                width = 0.0f,
+                                costModifier = -1.0f,
+                                bidirectional = true,
+                                area = NavMesh.GetAreaFromName("Walkable"),
+                                agentTypeID = agentTypeId
+                            }
+                        );
+                    }
+                    foreach (var link in lowerLandingLinks) {
+                        marker.AddRuntimeNavMeshLink(
+                            new NavMeshLinkData() {
+                                startPosition = link.roomHit.position,
+                                endPosition = link.landingHit.position,
+                                width = 0.0f,
+                                costModifier = -1.0f,
+                                bidirectional = true,
+                                area = NavMesh.GetAreaFromName("Walkable"),
+                                agentTypeID = agentTypeId
+                            }
+                        );
+                    }
+                    marker.AddRuntimeNavMeshLink(
+                        new NavMeshLinkData() {
+                            startPosition = lowerMidHit.position,
+                            endPosition = upperMidHit.position,
+                            width = 0.0f,
+                            costModifier = -1.0f,
+                            bidirectional = true,
+                            area = NavMesh.GetAreaFromName("Walkable"),
+                            agentTypeID = agentTypeId
+                        }
+                    );
+                    foreach (var link in upperLandingLinks) {
+                        marker.AddRuntimeNavMeshLink(
+                            new NavMeshLinkData() {
+                                startPosition = link.landingHit.position,
+                                endPosition = link.roomHit.position,
+                                width = 0.0f,
+                                costModifier = -1.0f,
+                                bidirectional = true,
+                                area = NavMesh.GetAreaFromName("Walkable"),
+                                agentTypeID = agentTypeId
+                            }
+                        );
+                    }
+                    foreach (var roomHit in upperRampRoomHits) {
+                        marker.AddRuntimeNavMeshLink(
+                            new NavMeshLinkData() {
+                                startPosition = upperStairHit.position,
+                                endPosition = roomHit.position,
+                                width = 0.0f,
+                                costModifier = -1.0f,
+                                bidirectional = true,
+                                area = NavMesh.GetAreaFromName("Walkable"),
+                                agentTypeID = agentTypeId
+                            }
+                        );
+                    }
+
+                    var path = new NavMeshPath();
+                    if (
+                        !NavMesh.CalculatePath(
+                            lowerRampRoomHits[0].position,
+                            upperRampRoomHits[0].position,
+                            NavMesh.AllAreas,
+                            path
+                        )
+                        || path.status != NavMeshPathStatus.PathComplete
+                    ) {
+                        throw new InvalidOperationException(
+                            $"Connector '{connector.id}' has no complete NavMesh path "
+                            + $"for agent type {agentTypeId}."
+                        );
+                    }
+                }
+            }
+        }
