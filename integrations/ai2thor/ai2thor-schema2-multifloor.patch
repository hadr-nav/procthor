+        private static void addDoorNavMeshLinks(
+            IEnumerable<Thor.Procedural.Data.Door> doors,
+            IEnumerable<Wall> walls
+        ) {
+            var navMeshSurfaces = GameObject.FindObjectsOfType<NavMeshSurfaceExtended>()
+                .Where(surface => surface.isActiveAndEnabled)
+                .ToArray();
+            var wallsById = walls.ToDictionary(wall => wall.id);
+            foreach (
+                var door in doors.Where(door =>
+                    !String.IsNullOrEmpty(door.room1) && door.room0 != door.room1
+                )
+            ) {
+                var wall = wallsById[door.wall0];
+                var wallDirection = (wall.p1 - wall.p0).normalized;
+                var wallNormal = Vector3.Cross(Vector3.up, wallDirection);
+                var hole = getHoleBoundingBox(door);
+                var doorwayCenter = wall.p0
+                    + wallDirection * ((hole.min.x + hole.max.x) / 2.0f);
+                doorwayCenter.y = wall.p0.y;
+                var owner = GameObject.Find(door.id).GetComponent<ConnectionProperties>();
+
+                foreach (var surface in navMeshSurfaces) {
+                    var queryFilter = new NavMeshQueryFilter() {
+                        agentTypeID = surface.agentTypeID,
+                        areaMask = NavMesh.AllAreas
+                    };
+                    var halfUsableWidth = Mathf.Max(
+                        0.0f,
+                        (hole.max.x - hole.min.x) / 2.0f
+                            - surface.buildSettings.agentRadius
+                            - 0.05f
+                    );
+                    var linked = false;
+                    foreach (
+                        var lateralOffset in new[] {
+                            0.0f,
+                            -halfUsableWidth,
+                            halfUsableWidth
+                        }
+                    ) {
+                        var linkCenter = doorwayCenter + wallDirection * lateralOffset;
+                        NavMeshHit firstSide;
+                        NavMeshHit secondSide;
+                        var firstSampled = NavMesh.SamplePosition(
+                            linkCenter + wallNormal * 0.35f,
+                            out firstSide,
+                            0.2f,
+                            queryFilter
+                        );
+                        var secondSampled = NavMesh.SamplePosition(
+                            linkCenter - wallNormal * 0.35f,
+                            out secondSide,
+                            0.2f,
+                            queryFilter
+                        );
+                        if (!firstSampled || !secondSampled) {
+                            continue;
+                        }
+                        owner.AddRuntimeNavMeshLink(
+                            new NavMeshLinkData() {
+                                startPosition = firstSide.position,
+                                endPosition = secondSide.position,
+                                width = 0.0f,
+                                costModifier = -1.0f,
+                                bidirectional = true,
+                                area = NavMesh.GetAreaFromName("Walkable"),
+                                agentTypeID = surface.agentTypeID
+                            }
+                        );
+                        linked = true;
+                        break;
+                    }
+                    if (!linked) {
+                        throw new InvalidOperationException(
+                            $"Doorway '{door.id}' has no NavMesh surface on both sides "
+                            + $"for agent type {surface.agentTypeID}."
+                        );
+                    }
+                }
+            }
+        }
